# Konfigurasi Caddy untuk Melonbyte.
# Salin ke /etc/caddy/Caddyfile, lalu periksa dengan:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#
# Peran berkas ini:
#   1. Melayani berkas hasil build (dist/) sebagai situs statis.
#   2. Meneruskan /api/* ke server Node yang hanya mendengarkan di localhost:3001.
#   3. Mengurus sertifikat HTTPS Let's Encrypt secara otomatis.
#   4. Menambahkan header keamanan dan aturan cache.

{
	# Ganti dengan alamat email aktif Anda. Dipakai Let's Encrypt untuk pemberitahuan masa berlaku.
	email admin@melonbyte.biz.id

	# Batasi header dan waktu koneksi agar slowloris tidak menahan worker selamanya.
	servers {
		max_header_size 16KB
		# Hanya Cloudflare yang boleh menentukan alamat klien lewat Cf-Connecting-IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-IP
		timeouts {
			read_header 10s
			read_body 15s
			write 30s
			idle 60s
		}
	}
}

melonbyte.biz.id {
	encode zstd gzip

	# Header keamanan untuk seluruh balasan.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.midtrans.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self'; manifest-src 'self'; media-src 'none'; worker-src 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		X-DNS-Prefetch-Control "off"
		-Server
		-Via
	}

	# Jangan cache data pribadi atau balasan API di browser/proxy.
	header /api/* ?Cache-Control "no-store"
	header /struk* ?Cache-Control "no-store"
	header /akun* ?Cache-Control "no-store"
	header /admin* ?Cache-Control "no-store"

	# Batasi badan permintaan; API sendiri memakai batas 8 KB untuk JSON.
	request_body {
		max_size 64KB
	}

	# Jangan layani berkas sensitif atau jalur pemindai; jangan kembalikan index.html untuk itu.
	@blokir path /.env* /.git* /wp-* /xmlrpc.php /phpmyadmin* /server-status /actuator*
	handle @blokir {
		respond 404
	}

	# Berkas ber-hash dari Vite boleh disimpan lama di peramban; index.html tidak boleh.
	@aset path /assets/*
	header @aset Cache-Control "public, max-age=31536000, immutable"
	@ikon path /favicon.svg /icon-192.png /apple-touch-icon.png /og.png /robots.txt
	header @ikon Cache-Control "public, max-age=86400"
	@halaman path / /index.html
	header @halaman Cache-Control "no-cache"

	# API Node.
	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			# Cloudflare sudah divalidasi sebagai proxy tepercaya; teruskan IP klien asli.
			header_up X-Forwarded-For {client_ip}
			header_up -Cf-Connecting-Ip
		}
	}

	# Sitemap dinamis: daftar game aktif dibaca dari katalog server.
	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:3001
	}

	# Situs statis. Rute aplikasi memakai URL path, jadi semua alamat dilayani index.html.
	handle {
		root * /srv/melonbyte/dist
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/melonbyte.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# www diarahkan ke apex; Cloudflare mem-proxy CNAME www ke apex.
www.melonbyte.biz.id {
	redir https://melonbyte.biz.id{uri} permanent
}
