# Browser: URL publik proyek dan publishable key (sb_publishable_...) atau legacy anon key; bukan secret/service_role
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server: jangan awali secret dengan VITE_
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_TESTING=true
# Cek nickname (opsional): URL + kunci penyedia cek. Kosong = fitur cek nonaktif.
CHECK_API_URL=
CHECK_API_KEY=
# Default mati; aktifkan sementara hanya untuk uji sandbox terkontrol setelah akun/IP siap. Produksi wajib lulus tes end-to-end dahulu.
CHECKOUT_ENABLED=false
PORT=3001

# --- Fitur wajib: notifikasi email, kontak, webhook Digiflazz (opsional - checkout tetap jalan tanpa ini) ---
# Kunci API Brevo (gratis 300 email/hari) untuk notifikasi status pesanan.
BREVO_API_KEY=
# Alamat pengirim yang sudah diverifikasi di Brevo.
MAIL_FROM=
# Nama pengirim di inbox pembeli.
MAIL_FROM_NAME=Melonbyte
# Alamat toko yang dipakai di tautan email notifikasi (isi domain produksi saat live).
STORE_URL=http://localhost:5173
# Rahasia HMAC-SHA1 webhook Digiflazz (samakan dengan dashboard Digiflazz).
DIGIFLAZZ_WEBHOOK_SECRET=
# Email bantuan yang tampil di halaman Bantuan & Kontak.
SUPPORT_EMAIL=
# Nomor WhatsApp bantuan (contoh 08xxxxxxxxxx). Kosong = tombol WA tidak tampil.
SUPPORT_WHATSAPP=
